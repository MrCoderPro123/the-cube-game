[sub_resource type="GDScript" id="GDScript_x3ivu"]
script/source = "extends Button

@onready var reset_dialog: ConfirmationDialog = %ResetDialog

func _on_pressed() -> void:
	reset_dialog.popup()

func _on_reset_dialog_confirmed() -> void:
	GlobalValues.reset_data()
	get_tree().reload_current_scene()
"

[sub_resource type="GDScript" id="GDScript_giwx5"]
script/source = "extends Button

const MAIN_MENU = preload(\"uid://bvgvw3ct0bv1o\")

func _on_pressed() -> void:
	LevelManager.switch_to_main_menu()
"

[sub_resource type="GDScript" id="GDScript_dcrs4"]
resource_name = "CoinsLbl"
script/source = "extends Label


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	text = \"Coins: \" + str(GlobalValues.coins)


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	text = \"Coins: \" + str(GlobalValues.coins)
"

